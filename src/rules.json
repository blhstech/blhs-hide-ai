[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": { "transform": { "queryTransform": { "removeParams": ["udm", "aep"] } } }
    },
    "condition": {
      "regexFilter": "^https://www\\.google\\.[a-z.]+/search\\?(.*&)?udm=50(&|$)",
      "resourceTypes": ["main_frame"]
    }
  },
  {
    "id": 2,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": { "regexSubstitution": "\\1/" }
    },
    "condition": {
      "regexFilter": "^(https://www\\.google\\.[a-z.]+)/(ai|aimode)([/?].*)?$",
      "resourceTypes": ["main_frame"]
    }
  },
  {
    "id": 3,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": { "regexSubstitution": "https://www.bing.com/search?\\2" }
    },
    "condition": {
      "regexFilter": "^https://(www\\.)?bing\\.com/copilotsearch(?:\\?(.*))?$",
      "resourceTypes": ["main_frame"]
    }
  },
  {
    "id": 4,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": { "url": "https://www.bing.com/" }
    },
    "condition": {
      "regexFilter": "^https://(www\\.)?bing\\.com/chat([/?].*)?$",
      "resourceTypes": ["main_frame"]
    }
  }
]
